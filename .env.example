# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shadow_ai_detection
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/shadow_ai_detection

# Backend Port
PORT=5000

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5000

# Gmail SMTP 2FA Configuration
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
